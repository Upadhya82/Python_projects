FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET_KEY=change-me-jwt-secret-key

# PostgreSQL connection string (used in production/docker)
DATABASE_URL=postgresql://hotel_user:hotel_pass@db:5432/hotel_db

# CORS allowed origins (comma-separated or *)
CORS_ORIGINS=*

# Server port (used by gunicorn/flask)
PORT=5000
